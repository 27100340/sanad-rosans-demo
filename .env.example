# Gemini covers recitation audio (Live API transcribe) and handwriting vision.
# See src/lib/ai/gemini.ts and src/lib/ai/gemini-live.ts. Without it those two
# features fall back to their scripted, deterministic behaviour.
GEMINI_API_KEY=

# Groq drives every text seat: tutor, briefs, marking, triage, planner, studio,
# assistant. See src/lib/ai/groq.ts. Without it those seats answer from script
# and the top bar shows "AI scripted".
GROQ_API_KEY=

# Set to "false" to force the scripted fallback even when a key is configured.
# The public preview deployment sets this; local development leaves it unset.
SANAD_AI_ENABLED=
